{
  "name": "swamp-murlocs-desktop",
  "version": "1.2.2",
  "description": "Локальный Twitch-оверлей с мурлоками для OBS",
  "author": "Twitch Visuals",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "stage": "node stage.cjs",
    "dist:win": "npm run stage && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "npm run stage && electron-builder --mac --arm64 --dir --publish never",
    "dist:linux": "npm run stage && electron-builder --linux --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.twitchvisuals.swampmurlocs",
    "productName": "Swamp Murlocs",
    "asar": true,
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.cjs",
      "ui/**/*",
      "build/icon.png",
      "package.json",
      "local-server.cjs",
      "diagnostics.cjs",
      "updates.cjs"
    ],
    "extraResources": [
      {
        "from": "staged-overlay",
        "to": "overlay",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "npmRebuild": false,
    "forceCodeSigning": false,
    "mac": {
      "target": "dir",
      "artifactName": "Swamp-Murlocs-${version}-macOS-${arch}.${ext}",
      "identity": null,
      "notarize": false,
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Swamp-Murlocs-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Swamp-Murlocs-${version}-Windows-${arch}-Setup.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "Swamp-Murlocs-${version}-Windows-${arch}-Portable.${ext}"
    },
    "electronFuses": {
      "enableNodeCliInspectArguments": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jommmain",
        "repo": "Twitch-overlay",
        "private": false,
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
